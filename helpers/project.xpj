[PROJECT]
    VERSION       = 2.1
    Project.xpj

[Project.xpj]
    ical-helper.dll
    event-helper.dll

[ical-helper.dll]
    COMPILE       = xpp
    COMPILE_FLAGS = /DLL:DYNAMIC /ga /wi /wl /wu /w
    DEBUG         = yes
    GUI           = no
    LINKER        = alink
    LINK_FLAGS    = /dll
    RC_COMPILE    = arc
    RC_FLAGS      = 
    POST_BUILD    = 
    POST_BUILD    = 
// $START-AUTODEPEND  
// $STOP-AUTODEPEND
    ical-helper.prg

[event-helper.dll]
    COMPILE       = xpp
    COMPILE_FLAGS = /DLL:DYNAMIC /ga /wi /wl /wu /w
    DEBUG         = yes
    GUI           = no
    LINKER        = alink
    LINK_FLAGS    = /dll
    RC_COMPILE    = arc
    RC_FLAGS      = 
    POST_BUILD    = 
    POST_BUILD    = 
// $START-AUTODEPEND   
// $STOP-AUTODEPEND
    event-helper.prg
